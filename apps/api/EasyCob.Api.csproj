    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);EasyCob.Core/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
